# ---- Supabase -> Project Settings -> Database -> Connection string (use the "Session pooler" URI)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- Supabase Storage (for applicants' resumes). Project Settings -> API. Create a PRIVATE bucket named "resumes".
# Leave both empty in development: resumes are then saved in backend/uploads/
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=resumes

# ---- Flask
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5000            # the public address of the website (used in emails, sitemap, certificate QR codes)
APP_TIMEZONE=Asia/Kolkata
# PRODUCTION=1                            # turns on strict checks and REFUSES the demo payment gateway and dev OTP display
# TRUST_PROXY=1                           # only behind a proxy you control (Render, Nginx): use X-Forwarded-For for client IPs
# FRONTEND_DIST=../frontend/dist          # where `npm run build` put the website; Flask serves it with search-engine friendly pages

# ---- Email (optional). Without BREVO_API_KEY or SMTP_HOST, emails are only saved in the `outbox` table.
# On Render FREE use BREVO_API_KEY (HTTPS): Render's free plan blocks SMTP ports. SMTP_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Payments (optional). Without these keys a clearly labelled DEMO gateway is used (no real money; refused when PRODUCTION=1).
# Razorpay dashboard -> Settings -> API keys. Webhook URL to register:  https://YOUR-DOMAIN/api/webhooks/razorpay
# (events: payment.captured, order.paid, payment.failed, payment.dispute.created, refund.processed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Automation
AUTO_SCHEDULER=0                          # 1 = run the rules (reminders, task unlock, certificates ...) inside the web process
AUTO_INTERVAL_MIN=30                      # ... every N minutes. Or leave 0 and put `flask --app app run-automations` in cron.

# ---- AI-assisted review (optional). Without a key everything still works using rules; with one, task drafts + question drafting use a model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- SMS / WhatsApp (optional). Any gateway or automation tool that accepts POST {"to": "...", "message": "..."}.
# Without these, OTP codes and instant enquiry alerts are saved in the `outbox` table only.
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=

# ---- Operations (optional)
REDIS_URL=                                # shared rate limits when you run several instances, e.g. redis://localhost:6379/0
ALERT_WEBHOOK_URL=                        # errors are posted here (Slack, Discord, ntfy.sh ...) so you hear about them on your phone
SENTRY_DSN=

# ---- Development only (never in production)
# DEV_SHOW_OTP=1                          # shows OTP codes on screen so you can try verification without an SMS gateway

# ---- Free-hosting helpers
CRON_SECRET=                              # long random string. Lets GitHub Actions / cron-job.org call /api/cron/run to run the automations (the app may be asleep)
EMAIL_DAILY_LIMIT=0                       # free email plans cap sending (for example 100 a day). Reminders wait in a queue when 80% is used. 0 = no limit

KEEP_AWAKE=0                              # 1 = the app pings its own address every 4 minutes so a free host does not put it to sleep
